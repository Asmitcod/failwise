# Neon Postgres connection string (use the pooled connection string for Vercel).
DATABASE_URL=

# GitHub App webhook secret used for X-Hub-Signature-256 validation.
GITHUB_WEBHOOK_SECRET=

# GitHub App credentials. Grant Actions: read, Contents: read, and
# Pull requests: read. Store the private key with newlines or escaped \n.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Upstash QStash API token and signature-verification keys.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public HTTPS URL for POST /api/webhooks/qstash.
QSTASH_WORKER_URL=

# Long random secret for POST /api/operations/reconcile-outbox.
OUTBOX_RECONCILE_SECRET=
